# backups the installer makes
*.bak
*.bak.*

# theme files generated into the config dirs by `atlas-theme`
# (source of truth is themes/*/colors.sh + the atlas-theme renderer)
config/waybar/theme.css
config/alacritty/theme.toml
config/ghostty/theme.conf
config/rofi/theme.rasi
config/mango/theme.conf
config/swaync/theme.css
config/nvim/lua/atlas/palette.lua
config/nvim/lua/atlas/palette.lua.tmp

# LazyVim runtime state — nvim rewrites this itself (read markers for its
# NEWS.md). ~/.config/nvim symlinks INTO this repo, so tracking it would send
# the checkout dirty every time you dismiss a changelog.
config/nvim/lazyvim.json

# local wallpaper binaries (drop your own in config/mango/wallpaper/)
config/mango/wallpaper/*
!config/mango/wallpaper/.gitkeep

# fish runtime state — written by fish itself and by tool `init` snippets
# (atuin/opencode drop files here). ~/.config/fish symlinks INTO this repo,
# so without these every checkout goes dirty on first shell start.
config/fish/fish_variables
config/fish/conf.d/

# python bytecode from the dictation venv
__pycache__/
*.pyc

# editor / os cruft
.DS_Store
*.swp
result

# ── Planning artifacts, deliberately untracked ─────────────────
# This repo is an installer: it should say what to install and why a setting is
# the way it is, next to that setting. Audit reports, decision logs and one-time
# cleanup scripts are notes about a particular day, not instructions for the
# next machine. They live in ~/projects/wargames/atlas-cleanup/ instead.
docs/DECISIONS.md
docs/CLEANUP-*.md
docs/AUDIT-*.md
bin/cleanup-*
